        "type": "exit",
        "targets": ["aya"],
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "ten", "to": "center", "scale": 1.25 }
        ],
        "duration": 180
      }
    ],
    "speaker": "添",
    "speakerSub": "TEN",
    "text": ["はは、冗談。"]
  },
  {
    "motions": [
      {
        "type": "exit",
