        "duration": 500
      },
      {
        "type": "wait",
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "aya", "to": "right", "scale": 0.42 }
        ],
        "duration": 1000
      }
    ],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "うん、んん？　まだそんなに飲んでないです～。",
      "……たぶん。"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "\"たぶん\"と言っている時点で、自分の限界を把握できていない",
      "証拠だ。もうアウトに近い。"
    ]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "え～今日もお仕事頑張ったんですよ。",
      "私、お姉さんに褒めてほしいなあ。ね、いい子でしょ？"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["……。"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["エンジニアは大変だね。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["えっ、そういうことしちゃうの！？　わるい子だ！"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["……。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["う、冗談ですって～……。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["あ～あ、なんで人もバグも言うこと聞いてくれなんだろう。"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["人間は元から聞かないだろう。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["すぐそういうこと言う。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "……でも来ちゃうんですよね～、此処。",
      "お姉さんに会いに。"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["そういうこと言って、あとで恥ずかしくなっても知らないぞ。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "なりません～～",
      "……たぶん？"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["また\"たぶん\"。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["便利な言葉なのに。"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["逃げ道とも言うだろう。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["あは、手厳しい。"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["それで、今日は何から逃げているんだ？"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "えっ逃げてる前提なんですか？"
    ]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "………………あ～～、えっと。",
      "まあ、くだらないことなんですけど、その。"
    ]
  },
  {
    "motions": [
      {
        "type": "exit",
        "targets": ["rakuro", "aya"],
        "duration": 220
      },
      {
        "type": "flashback",
        "bg": "placeholder.jpg"
      },
      {
        "type": "enter",
        "targets": [
          { "id": "aya", "to": "center", "scale": 0.45 }
        ],
        "duration": 220
      }
    ],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["福岡に行ってたんだ？"]
  },
  {
    "motions": [
      {
        "type": "exit",
        "targets": ["aya"],
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "ten", "to": "center", "scale": 1.25 }
        ],
        "duration": 180
      }
    ],
    "speaker": "添",
    "speakerSub": "TEN",
    "text": [
      "そ。まあ仕事ですけどね",
      "てか、オレが此処に来てなかった理由とか気にならなかったんです？"
    ]
  },
  {
    "motions": [
      {
        "type": "exit",
        "targets": ["ten"],
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "aya", "to": "center", "scale": 0.45 }
        ],
        "duration": 180
      }
    ],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["あ～……大学生は忙しいって言うし、そういう時期かなって。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "（久しぶりに来たと思ったら怪我したとか言ってたし、",
      "どうしたのかなって思ったりもしたけど）"
    ]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "（お互い、あまり踏み込んじゃダメだろうなってなるって言うか。）"
    ]
  },
  {
    "motions": [
      {
        "type": "exit",
        "targets": ["aya"],
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "ten", "to": "center", "scale": 1.25 }
        ],
        "duration": 180
      }
    ],
    "speaker": "添",
    "speakerSub": "TEN",
    "text": ["……。"]
  },
  {
    "speaker": "添",
    "speakerSub": "TEN",
    "text": [
      "研修に行って、そのままオレが帰ってこなかったらどうします？"
    ]
  },
  {
    "motions": [
      {
        "type": "exit",
        "targets": ["ten"],
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "aya", "to": "center", "scale": 0.45 }
        ],
        "duration": 180
      }
    ],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["え、っと……。"]
  },
  {
    "motions": [
