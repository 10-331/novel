[
  {
    "bg": "placeholder.jpg",
    "motions": [
      {
        "type": "enter",
        "targets": [
          { "id": "rakuro", "to": "center", "scale": 0.1 }
        ],
        "duration": 1200
      }
    ],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "……今日、ちょっと飲みすぎじゃない？"
    ]
  },
  {
    "motions": [
      {
        "type": "move",
        "targets": [
          { "id": "rakuro", "to": "left", "scale": 0.1 }
        ],
        "duration": 500
      },
      {
        "type": "wait",
        "duration": 180
      },
      {
        "type": "enter",
        "targets": [
          { "id": "aya", "to": "right", "scale": 0.075 }
        ],
        "duration": 1000
      }
    ],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "うん、んん？　まだそんなに飲んでないです～。",
      "……たぶん。"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "\"たぶん\"と言っている時点で、自分の限界を把握できていない",
      "証拠だ。もうアウトに近い。"
    ]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "え～今日仕事頑張ったんですもん。",
      "私、お姉さんに褒めてほしいなあ。ね、いい子でしょ？"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["……。"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["エンジニアは大変だね。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["あ、そういうことしちゃうんだ～！？　悪い子！"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["え～～、どうして人もバグも言うこと聞いてくれないのかなあ？"]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["人間は元から聞かないだろう。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": ["すぐそう言う。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "……でも来ちゃうんですよね～、此処。",
      "お姉さんに会いに。"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["そういうこと言って、あとで恥ずかしくなっても知らないぞ。"]
  },
  {
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "なりません～～",
      "……たぶん？"
    ]
  },
  {
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": ["また\"たぶん\""]
  }
]
