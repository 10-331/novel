[
  {
    "bg": "placeholder.jpg",
    "chars": ["rakuro"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "……今日、ちょっと飲みすぎじゃない？"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "うん、んん？　まだそんなに飲んでないです～。",
      "……たぶん。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "\"たぶん\"と言っている時点で、自分の限界を把握できていない",
      "証拠だ。もうアウトに近い。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "え～今日仕事頑張ったんですもん。",
      "私、お姉さんに褒めてほしいなあ。ね、いい子でしょ？"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
   　 "……。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "エンジニアは大変だね。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "あ、そういうことしちゃうんだ～！？　悪い子！",
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "え～～、どうして人もバグも言うこと聞いてくれないのかなあ？"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "人間は元から聞かないだろう。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "すぐそう言う。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "……でも来ちゃうんですよね～、此処。",
      "お姉さんに会いに。"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "そういうこと言って、あとで恥ずかしくなっても知らないぞ。"
    ],
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "綾",
    "speakerSub": "AYA",
    "text": [
      "なりません～～",
      "……たぶん？"
    ]
  },
  {
"chars": ["rakuro:left","aya:right"],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "また\"たぶん\""
    ]
  }
  



]
