[
  {
    "bg": "bar.jpg",
    "motions": [
      {
        "type": "enter",
        "targets": [
          { "id": "rakuro", "to": "center", "scale": 0.5 }
        ],
        "duration": 1200
      }
    ],
    "speaker": "落露",
    "speakerSub": "RAKURO",
    "text": [
      "……今日、ちょっと飲みすぎじゃない？"
    ]
  },
  {
    "motions": [
      {
        "type": "move",
        "targets": [
          { "id": "rakuro", "to": "left", "scale": 0.5 }
